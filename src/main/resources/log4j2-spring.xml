<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout>
        <Pattern>
          %d{HH:mm:ss.SSS}
          [%style{%X{requestId}}{blue}]
          [%X{clientIp}{white}]
          %highlight{%-5level}
          %style{%logger{20}}{green}
          - %msg%n
        </Pattern>
      </PatternLayout>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>

